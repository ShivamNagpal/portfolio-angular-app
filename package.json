{
  "name": "portfolio-angular-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-local": "ng serve --host 0.0.0.0",
    "build": "./build.sh",
    "watch": "ng build --watch --configuration development",
    "prettier": "npx prettier . --write --ignore-unknown",
