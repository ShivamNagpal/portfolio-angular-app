    "@angular/compiler-cli": "22.2.2",
    "@types/express": "5.0.6",
    "@types/jasmine": "6.0.0",
    "@types/node": "24.19.1",
    "autoprefixer": "10.6.1",
    "istanbul-lib-instrument": "6.0.3",
    "jasmine-core": "6.3.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "postcss": "8.5.29",
