    "build-sitemap": "node scripts/build-sitemap.js",
    "test": "ng test --browsers ChromeHeadless --watch=false",
    "test-browser": "ng test",
    "serve:ssr:portfolio-angular-app": "node dist/portfolio-angular-app/server/server.mjs"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "22.2.2",
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/ssr": "22.2.2",
    "express": "5.3.0",
    "marked": "18.1.0",
    "ngx-markdown": "22.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
